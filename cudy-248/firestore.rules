rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function pp(uid) { return /databases/$(database)/documents/profiles/$(uid); }
  function admin() { return request.auth != null && exists(pp(request.auth.uid)) && get(pp(request.auth.uid)).data.role == 'admin' && get(pp(request.auth.uid)).data.active == true; }
  function active() { return request.auth != null && exists(pp(request.auth.uid)) && get(pp(request.auth.uid)).data.active == true; }
  function self(uid) { return active() && request.auth.uid == uid; }
  function dealer(uid) { return exists(pp(uid)) && get(pp(uid)).data.role == 'dealer'; }
  function text(x,max) { return x is string && x.size() <= max; }
  function validInt(x,min,max) { return x is int && x >= min && x <= max; }
  function profile(d) {
   return d.keys().hasAll(['username','name','role','rate_bps','active']) && d.keys().hasOnly(['username','name','role','rate_bps','active','discount_bps','code'])
    && text(d.username,100) && d.username.size() >= 3 && text(d.name,80) && d.name.size() >= 1 && d.active is bool
    && ((d.role == 'admin' && d.rate_bps == 0) || (d.role == 'dealer' && validInt(d.rate_bps,300,500)))
    && (!('discount_bps' in d) || validInt(d.discount_bps,0,5000)) && (!('code' in d) || d.code.matches('OP[0-9]{2}'));
  }
  match /profiles/{uid} {
   allow get: if admin() || (request.auth != null && request.auth.uid == uid);
   allow list: if admin();
   allow create: if admin() && profile(request.resource.data) && request.resource.data.role == 'dealer';
   allow update: if admin() && profile(request.resource.data) && request.resource.data.role == resource.data.role;
   allow delete: if false;
   // Legacy records are retained as an immutable archive. Their amounts are not new consignment balances.
   match /{collection}/{record} {
    allow get,list: if collection in ['sales','payments','orders'] && (admin() || self(uid));
    allow get,list: if collection == 'finance' && admin();
    allow write: if false;
   }
  }
  match /prices/{id} { allow read: if active(); allow write: if false; }
  match /costs/{id} { allow read: if admin(); allow write: if false; }
  match /consignment/settings {
   allow read: if active();
   allow create: if admin() && request.resource.data.keys().hasOnly(['currency','schema','source_name','created_at'])
    && request.resource.data.currency in ['USD','TMT','EUR','CNY','RUB','AED'] && request.resource.data.schema == 1
    && text(request.resource.data.source_name,100) && text(request.resource.data.created_at,35);
   allow update,delete: if false;
  }
  function item(d) {
   return d.keys().hasAll(['sku','model','description','category','price_known','price_minor','opening_qty','qty','source_row','source_no'])
    && d.keys().hasOnly(['sku','model','description','category','price_known','price_minor','opening_qty','qty','source_row','source_no'])
    && d.sku.matches('CUDY-[0-9]{3}') && text(d.model,100) && d.model.size() >= 1 && text(d.description,200) && text(d.category,100)
    && d.price_known is bool && validInt(d.price_minor,0,1000000000) && validInt(d.opening_qty,0,1000000000) && validInt(d.qty,0,1000000000)
    && validInt(d.source_row,1,1000000) && validInt(d.source_no,1,1000000);
  }
  match /consignmentItems/{sku} {
   allow read: if active();
   allow create: if admin() && item(request.resource.data) && request.resource.data.sku == sku && request.resource.data.qty == request.resource.data.opening_qty;
   allow update: if admin() && item(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty','price_minor','price_known']);
   allow delete: if false;
  }
  function account(d) { return d.keys().hasAll(['sales_minor','earned_minor','paid_minor']) && d.keys().hasOnly(['sales_minor','earned_minor','paid_minor']) && validInt(d.sales_minor,0,9007199254740991) && validInt(d.earned_minor,0,9007199254740991) && validInt(d.paid_minor,0,9007199254740991); }
  function event(uid,d) {
   return d.keys().hasAll(['kind','sku','model','quantity','unit_price_minor','amount_minor','rate_bps','commission_minor','currency','reference','note','source_event','created_at','returned_qty','reversed_minor','request_key'])
    && d.keys().hasOnly(['kind','sku','model','quantity','unit_price_minor','amount_minor','rate_bps','commission_minor','currency','reference','note','source_event','created_at','returned_qty','reversed_minor','request_key'])
    && d.kind in ['transfer','dealer_return','sale','customer_return','payment','receipt'] && text(d.sku,120) && text(d.model,100)
    && validInt(d.quantity,0,100000) && validInt(d.unit_price_minor,0,1000000000) && validInt(d.amount_minor,0,1000000000)
    && validInt(d.rate_bps,0,500) && validInt(d.commission_minor,0,1000000000) && d.currency == get(/databases/$(database)/documents/consignment/settings).data.currency
    && text(d.reference,80) && text(d.note,160) && text(d.source_event,120) && text(d.created_at,35) && d.created_at.size() >= 20
    && validInt(d.returned_qty,0,d.quantity) && validInt(d.reversed_minor,0,d.commission_minor) && text(d.request_key,64) && d.request_key.size() == 64
    && (d.kind != 'sale' || (d.reference.size() >= 1 && d.quantity > 0 && d.unit_price_minor > 0 && d.amount_minor == d.quantity*d.unit_price_minor && d.rate_bps >= 300 && d.commission_minor == int((d.amount_minor*d.rate_bps+5000)/10000)))
    && (!(d.kind in ['transfer','dealer_return','receipt']) || (d.quantity > 0 && d.amount_minor == 0 && d.commission_minor == 0 && d.rate_bps == 0))
    && (d.kind != 'payment' || (d.quantity == 0 && d.amount_minor > 0 && d.commission_minor == 0 && d.rate_bps == 0));
  }
  function report(d) { return d.keys().hasAll(['sku','model','quantity','unit_price_minor','reference','status','event_id','created_at','request_key']) && d.keys().hasOnly(['sku','model','quantity','unit_price_minor','reference','status','event_id','created_at','request_key']) && d.sku.matches('CUDY-[0-9]{3}') && text(d.model,100) && validInt(d.quantity,1,100000) && validInt(d.unit_price_minor,1,1000000000) && d.quantity*d.unit_price_minor <= 1000000000 && text(d.reference,80) && d.reference.size() >= 1 && text(d.created_at,35) && d.created_at.size() >= 20 && text(d.request_key,64) && d.request_key.size() == 64 && d.status in ['pending','approved','rejected'] && text(d.event_id,120); }
  match /consignmentAccounts/{uid} {
   allow get,list: if admin() || self(uid);
   allow create,update: if admin() && dealer(uid) && account(request.resource.data);
   allow delete: if false;
   match /stock/{sku} {
    allow read: if admin() || self(uid);
    allow create,update: if admin() && dealer(uid) && request.resource.data.keys().hasAll(['sku','model','qty']) && request.resource.data.keys().hasOnly(['sku','model','qty']) && request.resource.data.sku == sku && text(request.resource.data.model,100) && validInt(request.resource.data.qty,0,1000000000);
    allow delete: if false;
   }
   match /events/{id} {
    allow read: if admin() || self(uid);
    allow create: if admin() && dealer(uid) && event(uid,request.resource.data) && request.resource.data.returned_qty == 0 && request.resource.data.reversed_minor == 0 && (request.resource.data.kind != 'sale' || request.resource.data.rate_bps == get(pp(uid)).data.rate_bps);
    allow update: if admin() && resource.data.kind == 'sale' && event(uid,request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returned_qty','reversed_minor']) && request.resource.data.returned_qty >= resource.data.returned_qty && request.resource.data.reversed_minor >= resource.data.reversed_minor;
    allow delete: if false;
   }
   match /reports/{id} {
    allow read: if admin() || self(uid);
    allow create: if self(uid) && dealer(uid) && report(request.resource.data) && request.resource.data.status == 'pending' && request.resource.data.event_id == '';
    allow update: if admin() && report(request.resource.data) && resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','event_id'])
      && (request.resource.data.status == 'rejected' || (getAfter(/databases/$(database)/documents/consignmentAccounts/$(uid)/events/$(request.resource.data.event_id)).data.kind == 'sale' && getAfter(/databases/$(database)/documents/consignmentAccounts/$(uid)/events/$(request.resource.data.event_id)).data.sku == resource.data.sku && getAfter(/databases/$(database)/documents/consignmentAccounts/$(uid)/events/$(request.resource.data.event_id)).data.quantity == resource.data.quantity && getAfter(/databases/$(database)/documents/consignmentAccounts/$(uid)/events/$(request.resource.data.event_id)).data.unit_price_minor == resource.data.unit_price_minor));
    allow delete: if false;
   }
   match /references/{id} { allow read: if admin(); allow create: if admin() && dealer(uid) && request.resource.data.keys().hasOnly(['event_id']) && text(request.resource.data.event_id,120); allow update,delete: if false; }
  }
  match /consignmentAdminEvents/{id} {
   allow read: if admin();
   allow create: if admin() && ((request.resource.data.kind == 'receipt' && event(request.auth.uid,request.resource.data)) || (request.resource.data.kind == 'price' && request.resource.data.keys().hasOnly(['kind','sku','old_price_minor','old_price_known','new_price_minor','created_at','request_key']) && text(request.resource.data.sku,120) && validInt(request.resource.data.old_price_minor,0,1000000000) && validInt(request.resource.data.new_price_minor,0,1000000000) && request.resource.data.old_price_known is bool && text(request.resource.data.created_at,35) && text(request.resource.data.request_key,64)));
   allow update,delete: if false;
  }
 }
}
